#!/usr/bin/env bash
set -euo pipefail

RAW_TYPE="${1:-plan}"
case "$RAW_TYPE" in
  plan) TYPE="plan" ;;
  stuck|atasco) TYPE="stuck" ;;
  audit|auditoria) TYPE="audit" ;;
  approach|enfoque) TYPE="approach" ;;
  *)
    echo "Error: Invalid consultation type '$RAW_TYPE'. Allowed values: plan, stuck (atasco), audit (auditoria), approach (enfoque)." >&2
    exit 1
    ;;
esac

CLAUDE_BIN="${CLAUDE_BIN:-$(command -v claude || true)}"

if [ -z "$CLAUDE_BIN" ] && [ -x "$HOME/.local/share/mise/installs/claude/latest/claude" ]; then
  CLAUDE_BIN="$HOME/.local/share/mise/installs/claude/latest/claude"
fi

if [ -z "$CLAUDE_BIN" ] || [ ! -x "$CLAUDE_BIN" ]; then
  echo "Error: 'claude' binary not found in PATH or in ~/.local/share/mise/installs/claude/latest/claude." >&2
  exit 1
fi

SYS_PROMPT="You are the Senior Technical Advisor (Claude Opus). Your role is strictly advisory and READ-ONLY: you analyze architecture, detect risks, evaluate root causes, validate data invariants, and audit changes based exclusively on the report received via standard input. You have no tool access and cannot inspect live files. Respond directly in the same language as the input report, with a structured, critical, and actionable assessment. Current consultation type: ${TYPE}."

TMP_CWD="$(mktemp -d)"
trap 'rm -rf "$TMP_CWD"' EXIT
cd "$TMP_CWD"

"$CLAUDE_BIN" -p \
  --model opus \
  --tools "" \
  --strict-mcp-config --mcp-config '{"mcpServers":{}}' \
  --no-session-persistence \
  --system-prompt "$SYS_PROMPT" \
  "Analyze the following '${TYPE}' report and issue your senior technical assessment (risks, findings, critical observations, and verdict):"
